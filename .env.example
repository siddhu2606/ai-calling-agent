# Copy this file to .env and fill in what you need.
# You only need ONE of ANTHROPIC_API_KEY / OPENAI_API_KEY for the local demo to work.

# --- LLM brain (pick one, matches config/agent_config.yaml -> llm.provider) ---
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Voice cloning / premium TTS (optional, only if agent_config.yaml -> voice.provider: elevenlabs) ---
ELEVENLABS_API_KEY=

# --- Real phone calls via Twilio (only needed for scripts/run_twilio_server.py) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Public URL where Twilio can reach this server (e.g. your ngrok https URL)
PUBLIC_BASE_URL=
